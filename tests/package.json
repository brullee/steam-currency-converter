{
  "name": "steam-currency-converter-tests",
  "private": true,
  "description": "Unit (jsdom) and end-to-end (real Chromium) tests for the extension. Not part of the shipped extension.",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=20000 --test-force-exit \"unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=60000 --test-force-exit \"e2e/**/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "test:live": "node --test --test-concurrency=1 --test-timeout=120000 --test-force-exit \"live/**/*.test.js\""
  },
  "devDependencies": {
    "jsdom": "24.1.3",
    "puppeteer-core": "24.10.0"
  }
}
